<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TeliBank — Area Clienti</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    body { font-family: 'Inter', sans-serif; }
  </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">

  <!-- LOGIN VIEW -->
  <div id="login-view" class="min-h-screen grid md:grid-cols-2">
    <!-- Left Branding Panel -->
    <div class="bg-slate-900 text-white p-10 md:p-16 flex flex-col justify-between">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-blue-600 flex items-center justify-center font-bold text-xl">T</div>
        <span class="text-2xl font-bold tracking-tight">TeliBank</span>
      </div>
      
      <div class="my-12">
        <h1 class="text-3xl md:text-5xl font-bold leading-tight mb-6">
          Il tuo patrimonio, sempre sotto controllo.
        </h1>
        <p class="text-slate-400 text-lg leading-relaxed max-w-md">
          Accedi ai servizi bancari telematici di TeliBank per consultare il saldo contabile, verificare i movimenti e disporre operazioni in sicurezza.
        </p>
      </div>

      <div class="text-xs text-slate-500">
        © 2026 TeliBank S.p.A. — Tutti i diritti riservati. Connessione protetta TLS 1.3
      </div>
    </div>

    <!-- Right Form Panel -->
    <div class="flex items-center justify-center p-8 bg-white">
      <div class="w-full max-w-md space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-slate-900">Accesso Area Clienti</h2>
          <p class="text-sm text-slate-500 mt-1">Inserisci le tue credenziali personali per accedere al conto.</p>
        </div>

        <form id="login-form" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Titolare del Conto</label>
            <input type="text" id="username" required placeholder="Nome e Cognome"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
          </div>

          <div>
            <label class="block text-sm font-medium text-slate-700 mb-1">Codice PIN / Password</label>
            <input type="password" id="password" required placeholder="••••••"
              class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-blue-600 focus:border-blue-600 outline-none transition" />
          </div>

          <div id="login-error" class="hidden p-3 rounded-lg bg-red-50 border border-red-200 text-red-600 text-sm font-medium">
            Credenziali non valide. Verifica il nome titolare e il PIN inseriti.
          </div>

          <button type="submit"
            class="w-full py-3.5 px-6 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold shadow-sm transition">
            Accedi al Conto
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- DASHBOARD VIEW -->
  <div id="dashboard-view" class="hidden min-h-screen flex flex-col">
    <!-- Top Navbar -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-20">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold">T</div>
          <span class="font-bold text-lg tracking-tight">TeliBank</span>
        </div>

        <div class="flex items-center gap-4">
          <div class="text-right hidden sm:block">
            <p class="text-sm font-semibold text-slate-900">Zakaria Bouroumana</p>
            <p class="text-xs text-slate-500">Conto Giovani • IT84 T030 6909 4001 0000 0015 092</p>
          </div>
          <button id="logout-btn" class="px-3.5 py-2 rounded-lg text-sm font-medium text-slate-600 hover:bg-slate-100 transition">
            Esci
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-6xl mx-auto w-full px-4 sm:px-6 py-8 space-y-8 flex-1">
      <!-- Top Summary Row -->
      <div class="grid md:grid-cols-3 gap-6">
        <!-- Balance Card -->
        <div class="md:col-span-2 bg-slate-900 text-white rounded-2xl p-6 sm:p-8 flex flex-col justify-between shadow-sm">
          <div class="flex items-center justify-between">
            <div>
              <span class="text-xs uppercase tracking-wider text-slate-400 font-semibold">Saldo Disponibile</span>
              <div class="flex items-center gap-3 mt-2">
                <h2 id="balance-display" class="text-4xl sm:text-5xl font-bold tracking-tight">14,20 €</h2>
              </div>
            </div>
            <div class="flex gap-2">
              <button id="toggle-privacy" class="px-3.5 py-2 rounded-xl bg-slate-800 hover:bg-slate-700 text-xs font-medium transition">
                Nascondi Saldi
              </button>
              <button id="open-transfer-modal" class="px-4 py-2 rounded-xl bg-blue-600 hover:bg-blue-500 text-xs font-semibold transition">
                Invia Soldi
              </button>
            </div>
          </div>

          <div class="mt-8 pt-6 border-t border-slate-800 flex flex-wrap items-center justify-between gap-4 text-xs text-slate-400">
            <div>
              <span class="block text-slate-500">IBAN Conto Corrente</span>
              <span id="iban-text" class="font-mono text-slate-200">IT84 T030 6909 4001 0000 0015 092</span>
            </div>
            <button id="copy-iban" class="text-blue-400 hover:text-blue-300 font-medium">Copia IBAN</button>
          </div>
        </div>

        <!-- Virtual Debit Card -->
        <div class="bg-gradient-to-br from-blue-600 to-indigo-800 text-white rounded-2xl p-6 flex flex-col justify-between shadow-sm">
          <div class="flex justify-between items-start">
            <div>
              <p class="text-xs uppercase tracking-wider text-blue-200">Carta di Debito</p>
              <p class="font-bold text-lg">TeliBank Next</p>
            </div>
            <span id="card-status-badge" class="px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-400/20 text-emerald-200">
              Attiva
            </span>
          </div>

          <div class="my-6">
            <p class="font-mono text-lg tracking-widest">4539 •••• •••• 9026</p>
            <div class="flex gap-6 mt-2 text-xs text-blue-200">
              <span>SCAD: 09/29</span>
              <span>CVV: 814</span>
            </div>
          </div>

          <div class="flex items-center justify-between pt-3 border-t border-white/10">
            <span class="text-xs font-medium">Zakaria Bouroumana</span>
            <button id="freeze-card-btn" class="text-xs underline hover:text-blue-200">Blocca Carta</button>
          </div>
        </div>
      </div>

      <!-- Transactions Section -->
      <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="p-6 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <h3 class="text-lg font-bold text-slate-900">Movimenti Conto</h3>
            <p class="text-xs text-slate-500">Storico aggiornato delle entrate e uscite contabilizzate</p>
          </div>

          <div class="flex flex-wrap gap-2">
            <input type="text" id="search-tx" placeholder="Cerca movimento..."
              class="px-3.5 py-2 rounded-xl border border-slate-200 text-sm outline-none focus:border-blue-600" />
            <select id="filter-tx" class="px-3.5 py-2 rounded-xl border border-slate-200 text-sm outline-none bg-white">
              <option value="all">Tutti i movimenti</option>
              <option value="out">Solo Uscite</option>
              <option value="in">Solo Entrate</option>
            </select>
          </div>
        </div>

        <div id="tx-list" class="divide-y divide-slate-100"></div>
      </div>
    </main>
  </div>

  <!-- MODAL BONIFICO / INVIA SOLDI -->
  <div id="transfer-modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-5 shadow-xl">
      <div class="flex justify-between items-center">
        <h3 class="text-lg font-bold">Invia Denaro / Bonifico</h3>
        <button id="close-transfer-modal" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>

      <form id="transfer-form" class="space-y-4">
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Beneficiario</label>
          <input type="text" id="tx-recipient" required placeholder="Es. Centro Sportivo / Amico"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Causale</label>
          <input type="text" id="tx-desc" required placeholder="Es. Quota calcetto"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600" />
        </div>
        <div>
          <label class="block text-xs font-semibold uppercase text-slate-500 mb-1">Importo (€)</label>
          <input type="number" step="0.01" min="0.50" id="tx-amount" required placeholder="0.00"
            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-300 text-sm outline-none focus:border-blue-600" />
        </div>
        <div id="transfer-error" class="hidden text-xs text-red-600 font-medium">
          Importo superiore al saldo disponibile sul conto.
        </div>
        <button type="submit" class="w-full py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold text-sm">
          Conferma Invio
        </button>
      </form>
    </div>
  </div>

  <!-- MODAL RICEVUTA DETTAGLIO -->
  <div id="receipt-modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 space-y-4 shadow-xl">
      <div class="flex justify-between items-center border-b border-slate-100 pb-3">
        <span class="font-bold text-sm text-slate-900">Dettaglio Operazione TeliBank</span>
        <button id="close-receipt-modal" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
      </div>
      <div id="receipt-content" class="space-y-3 text-sm"></div>
    </div>
  </div>

  <script>
    const VALID_USER = "zakaria bouroumana";
    const VALID_PASS = "150926";

    let balance = 14.20;
    let privacyMode = false;
    let cardFrozen = false;

    const transactions = [
      { id: "TRN-90812", title: "Centro Sportivo Sporting", desc: "Partita di Calcetto a 5", date: "Ieri, 21:30", amount: -7.00, category: "Sport & Tempo Libero" },
      { id: "TRN-90784", title: "McDonald's McDrive", desc: "Pagamento POS Carta *9026", date: "12 Ott, 23:15", amount: -9.80, category: "Ristorazione" },
      { id: "TRN-90710", title: "Ricarica P2P da Amico", desc: "Quota pizza restituita", date: "10 Ott, 18:40", amount: 5.00, category: "Entrate" },
      { id: "TRN-90655", title: "Istanbul Doner Kebab", desc: "Menu Kebab + Bibita", date: "08 Ott, 13:50", amount: -6.50, category: "Ristorazione" },
      { id: "TRN-90599", title: "Iliad Italia S.p.A.", desc: "Rinnovo offerta mensile mobile", date: "05 Ott, 08:12", amount: -7.99, category: "Telefonia" },
      { id: "TRN-90512", title: "PlayStation Network", desc: "Acquisto FC Points", date: "02 Ott, 17:20", amount: -9.99, category: "Gaming" },
      { id: "TRN-90488", title: "Barber Shop Fade", desc: "Taglio capelli", date: "28 Set, 16:00", amount: -15.00, category: "Cura Persona" },
      { id: "TRN-90401", title: "Bonifico / Regalo", desc: "Ricarica conto corrente", date: "25 Set, 10:00", amount: 20.00, category: "Entrate" }
    ];

    const formatEuro = (val) => {
      if (privacyMode) return "••••• €";
      return val.toFixed(2).replace(".", ",") + " €";
    };

    const renderBalance = () => {
      document.getElementById("balance-display").textContent = formatEuro(balance);
    };

    const renderTransactions = () => {
      const search = document.getElementById("search-tx").value.toLowerCase();
      const filter = document.getElementById("filter-tx").value;
      const list = document.getElementById("tx-list");
      list.innerHTML = "";

      const filtered = transactions.filter(t => {
        const matchesText = t.title.toLowerCase().includes(search) || t.desc.toLowerCase().includes(search);
        const matchesType = filter === "all" || (filter === "out" && t.amount < 0) || (filter === "in" && t.amount > 0);
        return matchesText && matchesType;
      });

      filtered.forEach(t => {
        const isPos = t.amount > 0;
        const row = document.createElement("div");
        row.className = "p-4 sm:px-6 hover:bg-slate-50 flex items-center justify-between cursor-pointer transition";
        row.onclick = () => showReceipt(t);

        row.innerHTML = `
          <div class="flex items-center gap-3.5">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center font-bold text-xs ${isPos ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-100 text-slate-700'}">
              ${isPos ? 'IN' : 'OUT'}
            </div>
            <div>
              <p class="font-semibold text-sm text-slate-900">${t.title}</p>
              <p class="text-xs text-slate-500">${t.desc} • ${t.date}</p>
            </div>
          </div>
          <div class="text-right">
            <p class="font-bold text-sm ${isPos ? 'text-emerald-600' : 'text-slate-900'}">
              ${privacyMode ? '••• €' : (isPos ? '+' : '') + t.amount.toFixed(2).replace('.', ',') + ' €'}
            </p>
            <span class="text-[11px] text-slate-400">${t.category}</span>
          </div>
        `;
        list.appendChild(row);
      });
    };

    const showReceipt = (t) => {
      const modal = document.getElementById("receipt-modal");
      const content = document.getElementById("receipt-content");
      content.innerHTML = `
        <div class="bg-slate-50 p-4 rounded-xl text-center">
          <p class="text-xs text-slate-500">Importo Contabilizzato</p>
          <p class="text-2xl font-bold mt-1 ${t.amount > 0 ? 'text-emerald-600' : 'text-slate-900'}">
            ${(t.amount > 0 ? '+' : '') + t.amount.toFixed(2).replace('.', ',')} €
          </p>
        </div>
        <div class="space-y-2 pt-2">
          <div class="flex justify-between"><span class="text-slate-500">Esercente / Beneficiario:</span><span class="font-medium">${t.title}</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Descrizione:</span><span class="font-medium">${t.desc}</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Data Operazione:</span><span class="font-medium">${t.date}</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Categoria:</span><span class="font-medium">${t.category}</span></div>
          <div class="flex justify-between"><span class="text-slate-500">Codice Riferimento:</span><span class="font-mono text-xs">${t.id}</span></div>
        </div>
      `;
      modal.classList.remove("hidden");
    };

    // Login Handler
    document.getElementById("login-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const user = document.getElementById("username").value.trim().toLowerCase();
      const pass = document.getElementById("password").value.trim();

      if (user === VALID_USER && pass === VALID_PASS) {
        document.getElementById("login-error").classList.add("hidden");
        document.getElementById("login-view").classList.add("hidden");
        document.getElementById("dashboard-view").classList.remove("hidden");
        renderBalance();
        renderTransactions();
      } else {
        document.getElementById("login-error").classList.remove("hidden");
      }
    });

    // Logout
    document.getElementById("logout-btn").addEventListener("click", () => {
      document.getElementById("dashboard-view").classList.add("hidden");
      document.getElementById("login-view").classList.remove("hidden");
      document.getElementById("password").value = "";
    });

    // Privacy Toggle
    document.getElementById("toggle-privacy").addEventListener("click", (e) => {
      privacyMode = !privacyMode;
      e.target.textContent = privacyMode ? "Mostra Saldi" : "Nascondi Saldi";
      renderBalance();
      renderTransactions();
    });

    // Copy IBAN
    document.getElementById("copy-iban").addEventListener("click", (e) => {
      navigator.clipboard.writeText("IT84T0306909400100000015092");
      e.target.textContent = "Copiato!";
      setTimeout(() => e.target.textContent = "Copia IBAN", 1500);
    });

    // Freeze Card
    document.getElementById("freeze-card-btn").addEventListener("click", (e) => {
      cardFrozen = !cardFrozen;
      const badge = document.getElementById("card-status-badge");
      if (cardFrozen) {
        badge.textContent = "Bloccata";
        badge.className = "px-2.5 py-1 rounded-full text-xs font-semibold bg-red-400/30 text-red-200";
        e.target.textContent = "Sblocca Carta";
      } else {
        badge.textContent = "Attiva";
        badge.className = "px-2.5 py-1 rounded-full text-xs font-semibold bg-emerald-400/20 text-emerald-200";
        e.target.textContent = "Blocca Carta";
      }
    });

    // Filters
    document.getElementById("search-tx").addEventListener("input", renderTransactions);
    document.getElementById("filter-tx").addEventListener("change", renderTransactions);

    // Modals
    document.getElementById("open-transfer-modal").addEventListener("click", () => {
      document.getElementById("transfer-modal").classList.remove("hidden");
    });
    document.getElementById("close-transfer-modal").addEventListener("click", () => {
      document.getElementById("transfer-modal").classList.add("hidden");
    });
    document.getElementById("close-receipt-modal").addEventListener("click", () => {
      document.getElementById("receipt-modal").classList.add("hidden");
    });

    // New Transfer
    document.getElementById("transfer-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const recipient = document.getElementById("tx-recipient").value.trim();
      const desc = document.getElementById("tx-desc").value.trim();
      const amount = parseFloat(document.getElementById("tx-amount").value);

      if (amount > balance) {
        document.getElementById("transfer-error").classList.remove("hidden");
        return;
      }

      document.getElementById("transfer-error").classList.add("hidden");
      balance = Math.max(0, balance - amount);
      transactions.unshift({
        id: "TRN-" + Math.floor(10000 + Math.random() * 90000),
        title: recipient,
        desc: desc,
        date: "Oggi, adesso",
        amount: -amount,
        category: "Trasferimento"
      });

      renderBalance();
      renderTransactions();
      document.getElementById("transfer-form").reset();
      document.getElementById("transfer-modal").classList.add("hidden");
    });
  </script>
</body>
</html>
